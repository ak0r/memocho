---
interface Props {
  title?: string;
  subheading?: string;
}
const { title, subheading } = Astro.props;
---
<section class="page-header flex flex-col mb-4">
  {title && (
    <h1 class="mt-0 mb-1 leading-tight"> {title} </h1>
  )}
  {subheading && (
    <p class="text-minimal">
      {subheading}
    </p>
  )}
  <slot name="meta" />
  <slot />
</section>