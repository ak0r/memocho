---
/**
 * SchemaOrg.astro
 *
 * Minimal JSON-LD structured data.
 *
 * Supported:
 * - article
 * - breadcrumb
 * - website
 */

import type { CollectionEntry } from "astro:content";
import { siteConfig } from "@/site.config";
import type { Crumb } from "@/utils/breadcrumb.utils";
import { getPostUrl } from "@/utils/content.utils";

/* ============================================================================
   TYPES
============================================================================ */

type ContentEntry = CollectionEntry<"posts">;

type SchemaType =
  | "article"
  | "breadcrumb"
  | "website";

interface Props {
  type: SchemaType;
  entry?: ContentEntry;
  crumbs?: Crumb[];
}

const {
  type,
  entry,
  crumbs,
} = Astro.props;

/* ============================================================================
   GLOBALS
============================================================================ */

const siteUrl = siteConfig.url.replace(/\/$/, "");

/* ============================================================================
   ENTITIES
============================================================================ */

const person = {
  "@type": "Person",
  "@id": `${siteUrl}/#author`,

  name: siteConfig.author,
  url: siteUrl,
};

const publisher = {
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,

  name: siteConfig.title,
  url: siteUrl,
};

/* ============================================================================
   HELPERS
============================================================================ */

function getCollectionLabel(collection: string) {

  switch (collection) {

    case "travels":
      return "Travel";

    case "tech":
      return "Tech";

    default:
      return undefined;
  }
}

/* ============================================================================
   SCHEMA BUILDERS
============================================================================ */

function buildArticle(entry: ContentEntry) {

  const {
    title,
    description,
    published,
    updated,
    cover,
    tags,
    lang,
  } = entry.data;

  const canonicalUrl =
    new URL(getPostUrl(entry), siteUrl).href;

  const imageUrl = cover
    ? new URL(cover, siteUrl).href
    : new URL("/og/default.png", siteUrl).href;

  const section =
    getCollectionLabel(entry.collection);

  return {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    ...(description && {
      description,
    }),
    url: canonicalUrl,
    image: imageUrl,
    inLanguage: lang ?? "en",
    datePublished: published.toISOString(),
    dateModified:
      (updated ?? published).toISOString(),
    ...(tags?.length && {
      keywords: tags.join(", "),
    }),
    ...(section && {
      articleSection: section,
    }),
    author: person,
    publisher,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalUrl,
    },
  };
}

function buildBreadcrumb(crumbs: Crumb[]) {

  return {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((crumb, index) => {
      const isLast =
        index === crumbs.length - 1;
      return {
        "@type": "ListItem",
        position: index + 1,
        name: crumb.title,
        // Google recommends omitting item on current page
        ...(!isLast && {
          item: new URL(
            crumb.href,
            siteUrl
          ).href,
        }),
      };
    }),
  };
}

function buildWebsite() {

  return {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    name: siteConfig.title,
    description: siteConfig.description,
    url: siteUrl,
    publisher,
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate:
          `${siteUrl}/search?q={search_term_string}`,
      },
      "query-input":
        "required name=search_term_string",
    },
  };
}

/* ============================================================================
   RESOLVE SCHEMA
============================================================================ */

let schema:
  | Record<string, unknown>
  | null = null;

if (
  type === "article" &&
  entry
) {

  schema = buildArticle(entry);

} else if (
  type === "breadcrumb" &&
  crumbs &&
  crumbs.length > 1
) {

  schema = buildBreadcrumb(crumbs);

} else if (
  type === "website"
) {

  schema = buildWebsite();
}
---

{
  schema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema, null, 2)}
    />
  )
}