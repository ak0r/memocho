---
import { type AnyPost, collectionColors, getCountryIds } from "@/utils/content.utils";
import { formatDate, titleify } from "@/utils/text.utils";
import Icon from "./Icon.astro";

interface Props {
  post: AnyPost;
  enableFilter?: boolean;
  variant?: string;
}

const { post, enableFilter = false, variant = "default" } = Astro.props;
const normalize = (v?: string) => v?.toLowerCase();
const collectionLabel = titleify(post.collection);
const collectionColor = collectionColors[post.collection] ?? {};
---

<article 
  class="group flex items-center gap-4 py-2 px-2 -mx-2 mb-1 rounded-md hover:bg-elevated/30 transition"
  data-type={enableFilter ? normalize(post.data.type) : undefined}
  data-tags={enableFilter ? JSON.stringify((post.data.tags ?? []).map(normalize)) : undefined}
  data-destination={enableFilter ? JSON.stringify(getCountryIds(post).map(normalize)) : undefined}
>

  <time
    datetime={formatDate(post.data.published, 'seo')}
    class="shrink-0 font-mono text-minimal tabular-nums min-w-[5ch]"
  >
    {formatDate(post.data.published, 'archive')}
  </time>

  <div class="flex transition-colors items-center gap-2">
    {post.data.draft && (
      <span class="bg-fig/20 text-fig rounded-lg px-1.5 py-0.5 text-xs font-mono">
        Draft
      </span>
    )}

    {variant === "home" && (
      <span class="rounded-lg px-1.5 py-0.5 mr-2 text-xs font-mono"
        style={`
          color: ${collectionColor.text};
          background: color-mix(in srgb, ${collectionColor.text} 12%, transparent);
        `}>
        {collectionLabel}
      </span>
    )}

    <a
      href={`/${post.collection}/${post.id}`}
      class="text-base text-content group-hover:text-brand transition-colors"
    >
      {post.data.title}
    </a>
  </div>

  <div class="ml-auto text-minimal opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200">
    <Icon name="arrow-right" size={16} />
  </div>

</article>