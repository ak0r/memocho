---
import { type Post, getCountryIds } from "@/utils/content.utils";
import { formatDate, type DateVariant } from "@/utils/text.utils";
import Icon from "./Icon.astro";

interface Props {
  post: Post;
  enableFilter?: boolean;
  variant?: string;
  dateFormat?: DateVariant;
}

const { post, enableFilter = false, variant = "default", dateFormat = "archive" } = Astro.props;
const normalize = (v?: string) => v?.toLowerCase();
---

<article
  class="group flex flex-col gap-1 py-3 px-2 -mx-2 mb-1 rounded-md transition hover:bg-surface/70
    md:flex-row md:items-center md:gap-4 md:py-2"
  data-year={enableFilter ? post.data.published.getFullYear() : undefined}
  data-category={enableFilter ? normalize(post.data.category) : undefined}
  data-tags={enableFilter ? JSON.stringify((post.data.tags ?? []).map(normalize)) : undefined}
  data-destination={enableFilter ? JSON.stringify(getCountryIds(post).map(normalize)) : undefined}
  data-theme={enableFilter ? JSON.stringify((post.data.theme ?? []).map(normalize)) : undefined}
  data-country={enableFilter ? JSON.stringify((post.data.countries ?? []).map(normalize)) : undefined}
>

  <div class="flex items-center gap-2 text-xs text-minimal shrink-0 md:text-sm">
    <time
      datetime={formatDate(post.data.published, 'seo')}
      class="font-mono tabular-nums md:min-w-[5ch]">
      {formatDate(post.data.published, dateFormat)}
    </time>
    {post.data.draft && (
      <span class="badge bg-fig/20 text-fig">
        Draft
      </span>
    )}
  </div>

  {/* Title */}
  <a
    href={`/${post.id}`}
    class="min-w-0 flex-1 text-sm text-content transition-colors group-hover:text-brand md:truncate">
    {post.data.title}
  </a>

  {/* Desktop arrow */}
  <div class="hidden md:block text-minimal opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0">
    <Icon name="arrow-right" size={16} />
  </div>
</article>