---
import { buildCrumbs } from '@/utils/breadcrumb.utils';
import SchemaOrg from '@/components/SchemaOrg.astro';

interface Props {
  label?: string;
}

const { label } = Astro.props;
const pathname = Astro.url.pathname;
const crumbs = buildCrumbs(pathname, label);
---
{crumbs.length > 1 && (

  <SchemaOrg
    type="breadcrumb"
    crumbs={crumbs}
  />

  <nav class="breadcrumb mb-6 md:mb-8" aria-label="Breadcrumb">
    <ol class="breadcrumb__list flex items-center font-mono flex-wrap gap-1 p-0 m-0 list-none">

      {crumbs.map((crumb, index) => {
        const isLast = index === crumbs.length - 1;

        return (
          <li
            key={crumb.href}
            class="breadcrumb__item flex min-w-0 items-center gap-1 text-sm"
          >
            {isLast ? (
              <span class="min-w-0 truncate text-content" aria-current="page">
                {crumb.title}
              </span>
            ) : (
              <>
                <a
                  href={crumb.href}
                  class="text-content-muted no-underline hover:text-content"
                >
                  {crumb.title}
                </a>
                <span
                  class="opacity-40"
                  aria-hidden="true"
                >
                  /
                </span>
              </>
            )}
          </li>
        );
      })}

    </ol>
  </nav>
)}