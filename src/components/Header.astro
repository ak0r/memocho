---
import { siteConfig } from "@/site.config";
import Logo from '@/components/Logo.astro';

const currentPath = new URL(Astro.request.url).pathname;
function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="site-header sticky top-0 z-50 isolate bg-page border-b border-border w-full md:py-2 mb-8">
  <div class="wrap">
    <div class="flex items-center justify-between py-3 gap-4">
      <a href="/" aria-label={`${siteConfig.title} home`} class="site-logo no-underline text-muted shrink-0 flex justify-start hover:text-content!">
        {siteConfig.logo ? (
          <Logo />
        ) : (
          <h2 class="text-inherit font-inherit m-0">
            {siteConfig.title}
          </h2>
        )}
      </a>

      <!-- Desktop nav links -->
      <div class="hidden md:inline-flex items-center gap-4">
        {siteConfig.navigation.map((item) => (
          <a
            href={item.url}
            class="nav-link"
            aria-current={isActive(item.url) ? "page" : undefined}
          >
            {item.title}
          </a>
        ))}
      </div>

      <!-- Theme toggle + hamburger (grouped right) -->
      <div class="flex items-center gap-3">
        <button
          id="theme-toggle"
          class="btn btn--ghost btn--icon"
          aria-label="Toggle theme"
          title="Toggle light/dark theme"
        >
          <svg class="icon-sun hidden" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <svg class="icon-moon block" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>

        <button
          id="nav-toggle"
          class="md:hidden btn btn--ghost btn--icon"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="nav-mobile"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" x2="20" y1="6" y2="6"/>
            <line x1="4" x2="20" y1="12" y2="12"/>
            <line x1="4" x2="20" y1="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile dropdown -->
  <div id="nav-mobile" class="site-header__mobile border-t border-border bg-page" hidden>
    <div class="site-header__mobile-inner flex flex-col px-4 py-4 gap-1">
      {siteConfig.navigation.map((item) => (
        <a
          href={item.url}
          class="nav-link text-base py-2.5 px-3 rounded-lg w-full hover:font-bold"
          aria-current={isActive(item.url) ? "page font-medium" : undefined}
        >
          {item.title}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.style.colorScheme !== 'dark';
    document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (_) {}
  });

  function initMobileNav() {
    const navToggle = document.getElementById('nav-toggle');
    const navMobile = document.getElementById('nav-mobile');
    if (!navToggle || !navMobile) return;

    // Toggle open/close
    navToggle.addEventListener('click', () => {
      const isHidden = navMobile.hasAttribute('hidden');
      navMobile.toggleAttribute('hidden', !isHidden);
      navToggle.setAttribute('aria-expanded', String(isHidden));
    });

    // Close when a nav link is clicked (SPA navigation)
    navMobile.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        navMobile.setAttribute('hidden', '');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });

    // Close on resize to desktop
    const mq = window.matchMedia('(min-width: 641px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) {
        navMobile.setAttribute('hidden', '');
        navToggle.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navToggle.checked) {
        navToggle.checked = false;
      }
    });
  }

  initMobileNav();
  document.addEventListener('astro:after-swap', initMobileNav);
</script>

<style>

  .site-header {
    /* Scroll shadow via animation-timeline — appears after ~1px scroll */
    animation: header-shadow linear both;
    animation-timeline: scroll();
    animation-range: 0px 1px;
  }

  @keyframes header-shadow {
    from { box-shadow: none; }
    to   { box-shadow: 0 1px 12px 0 color-mix(in srgb, var(--foreground) 8%, transparent); }
  }

  /* Reading progress — thin line pinned below the sticky header */
  .site-header::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-brand);
    transform-origin: left;
    transform: scaleX(0);
    animation: reading-progress linear;
    animation-timeline: scroll();
  }

  @keyframes reading-progress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  .site-header__mobile {
    /* Slide-down entrance */
    animation: mobile-menu-in 150ms ease both;
  }

  @keyframes mobile-menu-in {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  :root[style*="dark"] .icon-sun  { display: block; }
  :root[style*="dark"] .icon-moon { display: none; }

</style>