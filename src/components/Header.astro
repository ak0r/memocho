---
import { siteConfig } from "@/site.config";
import Logo from '@/components/Logo.astro';
import Icon from "@/components/Icon.astro";

const currentPath = new URL(Astro.request.url).pathname;
function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="site-header sticky top-0 z-50 isolate bg-page border-b border-border w-full md:py-2 mb-8">
  <div class="wrap">
    <div class="flex items-center justify-between py-3 gap-4">
      <a href="/" aria-label={`${siteConfig.title} home`} class="site-logo no-underline text-muted shrink-0 flex justify-start hover:text-content!">
        {siteConfig.logo ? (
          <Logo />
        ) : (
          <h2 class="text-inherit font-inherit m-0">
            {siteConfig.title}
          </h2>
        )}
      </a>

      <!-- Desktop nav links -->
      <div class="hidden md:inline-flex items-center gap-4">
        {siteConfig.navigation.map((item) => (
          <a
            href={item.url}
            class="nav-link animate"
            aria-current={isActive(item.url) ? "page" : undefined}
          >
            {item.title}
          </a>
        ))}
      </div>

      <!-- Theme toggle + hamburger (grouped right) -->
      <div class="flex items-center gap-3">
        <pagefind-modal-trigger compact hide-shortcut>
        </pagefind-modal-trigger>
        <button
          id="theme-toggle"
          class="btn btn--ghost btn--icon"
          aria-label="Toggle theme"
          title="Toggle light/dark theme"
        >
        <Icon name="sun" size={20} class="hidden icon icon-sun text-muted animate"/>
        <Icon name="moon" size={20} class="block icon icon-moon text-muted animate"/>
        <!-- <svg class="icon-sun hidden text-muted" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg class="icon-moon block" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg> -->
        </button>

        <button
          id="nav-toggle"
          class="md:hidden btn btn--ghost btn--icon"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="nav-mobile"
        >
          <!-- <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" x2="20" y1="6" y2="6"/>
            <line x1="4" x2="20" y1="12" y2="12"/>
            <line x1="4" x2="20" y1="18" y2="18"/>
          </svg> -->
          <Icon name="menu" size={20} class="icon icon-menu text-muted block animate" />
          <Icon name="x" size={20} class="icon icon-close text-muted hidden animate" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile dropdown -->
  <div id="nav-mobile" class="site-header__mobile border-t border-border bg-page" hidden>
    <div class="site-header__mobile-inner flex flex-col mx-auto px-4 py-4 gap-4">
      {siteConfig.navigation.map((item) => (
        <a
          href={item.url}
          class="nav-link animate mx-auto"
          aria-current={isActive(item.url) ? "page" : undefined}
        >
          {item.title}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  
  function updateThemeIcons() {
    const sun  = document.querySelector('.icon-sun');
    const moon = document.querySelector('.icon-moon');

    if (!sun || !moon) return;

    const isDark = document.documentElement.style.colorScheme === 'dark';

    if (isDark) {
      sun.classList.remove('hidden');
      sun.classList.add('block');

      moon.classList.remove('block');
      moon.classList.add('hidden');
    } else {
      sun.classList.add('hidden');
      sun.classList.remove('block');

      moon.classList.remove('hidden');
      moon.classList.add('block');
    }
  }

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark =
      document.documentElement.style.colorScheme !== 'dark';
    const theme = isDark ? 'dark' : 'light';
    document.documentElement.style.colorScheme = theme;
    // Pagefind theme
    document.documentElement.setAttribute('data-pf-theme', theme);
    try {
      localStorage.setItem('theme', theme);
    } catch (_) {}
    updateThemeIcons();
  });

  function updateNavIcons(isOpen) {
    const menu  = document.querySelector('.icon-menu');
    const close = document.querySelector('.icon-close');
    if (!menu || !close) return;

    if (isOpen) {
      menu.classList.remove('block');
      menu.classList.add('hidden');

      close.classList.remove('hidden');
      close.classList.add('block');
    } else {
      menu.classList.remove('hidden');
      menu.classList.add('block');

      close.classList.remove('block');
      close.classList.add('hidden');
    }
  }

  function initMobileNav() {
    const navToggle = document.getElementById('nav-toggle');
    const navMobile = document.getElementById('nav-mobile');
    if (!navToggle || !navMobile) return;

    // Toggle open/close
    navToggle.addEventListener('click', () => {
      const isHidden = navMobile.hasAttribute('hidden');
      const willOpen = isHidden;

      navMobile.toggleAttribute('hidden', !isHidden);
      navToggle.setAttribute('aria-expanded', String(willOpen));

      updateNavIcons(willOpen); 
    });

    navMobile.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        navMobile.setAttribute('hidden', '');
        navToggle.setAttribute('aria-expanded', 'false');
        updateNavIcons(false); 
      });
    });

    // Close on resize to desktop
    const mq = window.matchMedia('(min-width: 641px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) {
        navMobile.setAttribute('hidden', '');
        navToggle.setAttribute('aria-expanded', 'false');
        updateNavIcons(false); 
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        navMobile.setAttribute('hidden', '');
        navToggle.setAttribute('aria-expanded', 'false');
        updateNavIcons(false); 
      }
    });

    const isOpen = !navMobile.hasAttribute('hidden');
    updateNavIcons(isOpen);
  }

  initMobileNav();
  updateThemeIcons();
  document.addEventListener('astro:after-swap', updateThemeIcons);
  document.addEventListener('astro:after-swap', initMobileNav);
</script>

<style>

  .site-header {
    /* Scroll shadow via animation-timeline — appears after ~1px scroll */
    animation: header-shadow linear both;
    animation-timeline: scroll();
    animation-range: 0px 1px;
  }

  @keyframes header-shadow {
    from { box-shadow: none; }
    to   { box-shadow: 0 1px 12px 0 color-mix(in srgb, var(--foreground) 8%, transparent); }
  }

  /* Reading progress — thin line pinned below the sticky header */
  .site-header::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-brand);
    transform-origin: left;
    transform: scaleX(0);
    animation: reading-progress linear;
    animation-timeline: scroll();
  }

  @keyframes reading-progress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  .site-header__mobile {
    /* Slide-down entrance */
    animation: mobile-menu-in 150ms ease both;
  }

  @keyframes mobile-menu-in {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  :root[style*="dark"] .icon-sun  { display: block; }
  :root[style*="dark"] .icon-moon { display: none; }

</style>