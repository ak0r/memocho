---
import Logo from '@/components/Logo.astro';
---

<header class="site-header border-b border-border w-full py-4 md:py-6 mb-8">
  <div class="wrap">

    <!-- TOP ROW -->
    <div class="flex items-center justify-between">

      <!-- BRAND -->
      <div class="flex flex-col">
        <Logo />
        <span class="text-sm">Tagline</span>
      </div>

      <!-- ACTIONS -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">

        <!-- Search -->
        <button class="btn btn--ghost btn--icon" aria-label="Search">
          🔍
        </button>

        <!-- Theme -->
        <button
          id="theme-toggle"
          class="btn btn--ghost btn--icon"
          aria-label="Toggle theme"
        >
          <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"> 
            <circle cx="12" cy="12" r="4"/> 
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/> 
          </svg> 
          <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"> 
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/> 
          </svg>
        </button>

        <!-- Menu (mobile only) -->
        <button
          id="nav-toggle"
          class="btn btn--ghost btn--icon md:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="nav-mobile"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"> 
            <line x1="4" x2="20" y1="6" y2="6"/> 
            <line x1="4" x2="20" y1="12" y2="12"/> 
            <line x1="4" x2="20" y1="18" y2="18"/> 
          </svg>
        </button>
      </div>
    </div>

    <!-- MOBILE COLLAPSIBLE NAV -->
    <div
      id="nav-mobile"
      class="overflow-hidden max-h-0 transition-all duration-300 ease-in-out md:hidden"
    >
      <nav class="flex flex-col gap-2 mt-4 text-base font-medium">
        <a href="/">Home</a>
        <a href="/about">About</a>
      </nav>
    </div>

    <!-- DESKTOP NAV -->
    <nav class="hidden md:flex justify-center gap-4 mt-4 text-base font-medium opacity-80">
      <a href="/" class="hover:opacity-100">Home</a>
      <a href="/about" class="hover:opacity-100">About</a>
    </nav>

    <!-- <div class="wave-separator mt-2 md:mt-4"></div> -->
  </div>
</header>

<!-- Minimal JS -->
<script>
  const btn = document.getElementById('nav-toggle');
  const nav = document.getElementById('nav-mobile');

  btn?.addEventListener('click', () => {
    const isOpen = nav.style.maxHeight && nav.style.maxHeight !== '0px';

    if (isOpen) {
      nav.style.maxHeight = '0px';
      btn.setAttribute('aria-expanded', 'false');
    } else {
      nav.style.maxHeight = nav.scrollHeight + 'px';
      btn.setAttribute('aria-expanded', 'true');
    }
  });
</script>