---
import { Picture } from 'astro:assets';
import { getCoverImage } from '@/utils/image.utils';

interface Props {
  cover: string; 
  alt: string;  
}

const { cover, alt } = Astro.props;
const coverImage = getCoverImage(cover);
---

{coverImage && (
  <section>
    <figure class="post-cover">
      <Picture
        src={coverImage}
        alt={alt}
        width={900}
        formats={['avif', 'webp']}
        loading="eager"
        decoding="async"
      />
    </figure>
  </section>
)}