---
import { type TagInfo } from '@/utils/content.utils';
import Icon from '@/components/Icon.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  tags?:         TagInfo[];
  categories?:   string[];
  destinations?: string[];
  years?:        number[];
  themes?:       string[];
  countries?:    string[];
}

const {
  tags         = [],
  categories   = [],
  destinations = [],
  years        = [],
  themes       = [],
  countries    = [],
} = Astro.props;

const pill =
  "inline-flex items-center px-3 py-1 rounded-full text-xs font-medium transition-colors cursor-pointer text-muted border border-current/20 hover:text-content hover:border-current/40 aria-pressed:bg-elevated aria-pressed:text-content aria-pressed:border-transparent";

const advancedGroups = [
  {
    key:    "theme",
    label:  "Themes",
    values: themes.map(t => ({ label: t, value: t })),
  },
  {
    key:    "tag",
    label:  "Tags",
    values: tags.map(t => ({ label: `#${t.label}`, value: t.key })),
  },
  {
    key:    "category",
    label:  "Categories",
    values: categories.map(c => ({ label: c, value: c })),
  },
  {
    key:    "destination",
    label:  "Destination",
    values: destinations.map(d => ({ label: d, value: d })),
  },
  {
    key:    "country",
    label:  "Country",
    values: countries.map(c => ({ label: c, value: c })),
  },
].filter(g => g.values.length > 0);

const hasAdvanced = advancedGroups.length > 0;
---

<section id="post-filter" class="my-6 space-y-3">

  <SectionHeader title='Browse by'/>

  {/* ── Year pills — always visible ───────────────────────────── */}
  {years.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {years.map((year) => (
        <button
          class={pill}
          data-filter-dim="year"
          data-filter-val={String(year)}
          aria-pressed="false"
        >
          {year}
        </button>
      ))}
    </div>
  )}

  {/* ── Collapsible advanced filters ──────────────────────────── */}
  {hasAdvanced && (
    <details class="card-outline group" id="advanced-filters">

      <summary class="flex items-center justify-between gap-4 cursor-pointer list-none p-4">

        <div class="flex items-center gap-2">
          <span class="text-sm font-medium text-muted">Dig deeper</span>
          <span
            id="filter-active-count"
            hidden
            class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-mono bg-elevated text-content"
          />
        </div>

        <div class="flex items-center gap-3">
          <button
            id="filter-clear"
            hidden
            class="text-xs font-mono text-minimal hover:text-content transition-colors cursor-pointer"
            onclick="event.preventDefault()"
          >
            Clear ×
          </button>
          <Icon
            name="arrow-right"
            size={14}
            class="text-minimal transition-transform duration-200 rotate-90 group-open:-rotate-90"
          />
        </div>

      </summary>

      <div class="space-y-4 px-4 pb-4 border-t border-border pt-4">
        {advancedGroups.map((group) => (
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:gap-4">
            <span class="text-xs font-mono text-minimal w-24 shrink-0 pt-1">
              {group.label}
            </span>
            <div
              class="flex flex-wrap gap-2"
              role="group"
              aria-label={`Filter by ${group.label}`}
            >
              {group.values.map(({ label, value }) => (
                <button
                  class={pill}
                  data-filter-dim={group.key}
                  data-filter-val={value.toLowerCase().trim()}
                  aria-pressed="false"
                >
                  {label}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

    </details>
  )}

</section>

<style>
  summary::-webkit-details-marker { display: none; }
</style>

<script>
  function initFilter() {
    const feed        = document.querySelector<HTMLElement>(".post-feed");
    const bar         = document.getElementById("post-filter");
    const clear       = document.getElementById("filter-clear") as HTMLButtonElement | null;
    const activeCount = document.getElementById("filter-active-count");

    if (!feed || !bar) return;

    const pills      = bar.querySelectorAll<HTMLButtonElement>("[data-filter-dim]");
    const articles   = feed.querySelectorAll<HTMLElement>("article");
    const yearGroups = feed.querySelectorAll<HTMLElement>("[data-year-group]");

    const dims = ["year", "category", "tag", "destination", "theme", "country"] as const;
    type Dim = typeof dims[number];

    const params = new URLSearchParams(window.location.search);

    const active: Record<string, Set<string>> = Object.fromEntries(
      dims.map(dim => [dim, new Set(params.getAll(dim))])
    );

    // ── sync URL ────────────────────────────────────────────────

    function syncUrl() {
      const p = new URLSearchParams();
      for (const dim of dims) {
        if (active[dim].size === 0) continue;
        for (const val of active[dim]) p.append(dim, val);
      }
      const qs = p.toString();
      history.replaceState(null, "", qs ? `?${qs}` : window.location.pathname);
    }

    // ── apply ───────────────────────────────────────────────────

    function applyFilters() {
      const totalActive = dims.reduce((n, d) => n + active[d].size, 0);

      articles.forEach(el => {
        const year      = el.dataset.year     ?? "";
        const cat       = el.dataset.category ?? "";
        const tags      = JSON.parse(el.dataset.tags        ?? "[]") as string[];
        const dests     = JSON.parse(el.dataset.destination ?? "[]") as string[];
        const themes    = JSON.parse(el.dataset.theme       ?? "[]") as string[];
        const countries = JSON.parse(el.dataset.country     ?? "[]") as string[];

        let v = true;
        if (active.year.size            && !active.year.has(year))                        v = false;
        if (v && active.category.size   && !active.category.has(cat))                     v = false;
        if (v && active.tag.size        && !tags.some(t    => active.tag.has(t)))          v = false;
        if (v && active.destination.size && !dests.some(d  => active.destination.has(d))) v = false;
        if (v && active.theme.size      && !themes.some(t  => active.theme.has(t)))        v = false;
        if (v && active.country.size    && !countries.some(c => active.country.has(c)))   v = false;

        el.hidden = !v;
      });

      yearGroups.forEach(group => {
        const visible = [...group.querySelectorAll<HTMLElement>("article")].filter(a => !a.hidden);
        group.hidden = visible.length === 0;
        const countEl = group.querySelector("[data-count]");
        if (countEl) countEl.textContent = `${visible.length} ${visible.length === 1 ? "post" : "posts"}`;
      });

      pills.forEach(pill => {
        const dim = pill.dataset.filterDim!;
        const val = pill.dataset.filterVal ?? "";
        pill.setAttribute("aria-pressed", String(active[dim]?.has(val) ?? false));
      });

      if (clear) clear.hidden = totalActive === 0;

      if (activeCount) {
        activeCount.hidden = totalActive === 0;
        activeCount.textContent = totalActive > 0 ? String(totalActive) : "";
      }
    }

    // ── pill clicks ─────────────────────────────────────────────

    pills.forEach(pill => {
      pill.addEventListener("click", () => {
        const dim = pill.dataset.filterDim!;
        const val = pill.dataset.filterVal ?? "";
        active[dim].has(val) ? active[dim].delete(val) : active[dim].add(val);
        syncUrl();
        applyFilters();
      });
    });

    // ── clear — stopPropagation prevents toggling the details panel ──

    clear?.addEventListener("click", (e) => {
      e.stopPropagation();
      dims.forEach(dim => active[dim].clear());
      syncUrl();
      applyFilters();
    });

    applyFilters();
  }

  initFilter();
  document.addEventListener("astro:after-swap", initFilter);
</script>