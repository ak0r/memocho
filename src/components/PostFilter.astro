---
/**
 * PostFilter
 *
 * Client-side filter bar. State lives entirely in JS (Sets per dimension)
 * and is synced to the URL via history.replaceState — no page reloads,
 * true multi-select across all dimensions.
 *
 * Expects PostFeed to render articles with:
 *   data-year, data-tags (JSON array), data-type, data-destination (JSON array)
 * and year groups with data-year-group + data-count.
 */

import { type TagInfo } from '@/utils/content.utils';
import SectionHeader from '@/components/SectionHeader.astro';

interface Props {
  tags?:         TagInfo[];
  types?:        string[];
  destinations?: string[];
  years?:        number[];
}

const {
  tags         = [],
  types        = [],
  destinations = [],
  years        = [],
} = Astro.props;

// Pill classes — inactive / active. Active state is toggled by JS at runtime.
const pill = "inline-flex items-center px-3 py-1 rounded-full text-xs font-medium transition-colors cursor-pointer text-muted border border-current/20 hover:text-content hover:border-current/40 aria-pressed:bg-elevated aria-pressed:text-content aria-pressed:border-transparent";
---

<section class="my-8 card-outline" id="post-filter">

  <div class="flex items-center justify-between mb-4">
    <SectionHeader title="Filter" />
    <button
      id="filter-clear"
      hidden
      class="text-xs font-mono text-minimal hover:text-content transition-colors shrink-0 cursor-pointer"
    >
      Clear all ×
    </button>
  </div>

  <nav class="space-y-4" id="filter-groups">

    {/* YEAR */}
    {years.length > 0 && (
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:gap-4">
        <span class="text-xs font-mono text-minimal w-24 shrink-0 pt-1">Year</span>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by year">
          {years.map((year) => (
            <button
              class={pill}
              data-filter-dim="year"
              data-filter-val={String(year)}
              aria-pressed="false"
            >
              {year}
            </button>
          ))}
        </div>
      </div>
    )}

    {/* TAGS */}
    {tags.length > 0 && (
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:gap-4">
        <span class="text-xs font-mono text-minimal w-24 shrink-0 pt-1">Tags</span>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by tag">
          {tags.map((t) => (
            <button
              class={pill}
              data-filter-dim="tag"
              data-filter-val={t.key.toLowerCase().trim()}
              aria-pressed="false"
            >
              #{t.label}
            </button>
          ))}
        </div>
      </div>
    )}

    {/* TYPE */}
    {types.length > 0 && (
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:gap-4">
        <span class="text-xs font-mono text-minimal w-24 shrink-0 pt-1">Type</span>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by type">
          {types.map((t) => (
            <button
              class={pill}
              data-filter-dim="type"
              data-filter-val={t.toLowerCase().trim()}
              aria-pressed="false"
            >
              {t}
            </button>
          ))}
        </div>
      </div>
    )}

    {/* DESTINATION */}
    {destinations.length > 0 && (
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:gap-4">
        <span class="text-xs font-mono text-minimal w-24 shrink-0 pt-1">Destination</span>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by destination">
          {destinations.map((d) => (
            <button
              class={pill}
              data-filter-dim="destination"
              data-filter-val={d.toLowerCase().trim()}
              aria-pressed="false"
            >
              {d}
            </button>
          ))}
        </div>
      </div>
    )}

  </nav>
</section>

<script>
  function initFilter() {
    const feed  = document.querySelector<HTMLElement>(".post-feed");
    const bar   = document.getElementById("post-filter");
    const clear = document.getElementById("filter-clear") as HTMLButtonElement | null;

    if (!feed || !bar) return;

    const pills      = bar.querySelectorAll<HTMLButtonElement>("[data-filter-dim]");
    const articles   = feed.querySelectorAll<HTMLElement>("article");
    const yearGroups = feed.querySelectorAll<HTMLElement>("[data-year-group]");

    // ── state: one Set per dimension, seeded from URL ─────────────────────

    const dims = ["year", "tag", "type", "destination"] as const;
    type Dim = typeof dims[number];

    const params = new URLSearchParams(window.location.search);

    const active: Record<Dim, Set<string>> = {
      year:        new Set(params.getAll("year")),
      tag:         new Set(params.getAll("tag")),
      type:        new Set(params.getAll("type")),
      destination: new Set(params.getAll("destination")),
    };

    // ── sync URL without reloading ────────────────────────────────────────

    function syncUrl() {
      const p = new URLSearchParams();
      for (const dim of dims) {
        for (const val of active[dim]) p.append(dim, val);
      }
      const qs = p.toString();
      history.replaceState(null, "", qs ? `?${qs}` : window.location.pathname);
    }

    // ── apply filters to articles + year groups ───────────────────────────

    function applyFilters() {
      const hasActive = dims.some(d => active[d].size > 0);

      // show/hide articles
      articles.forEach(el => {
        const year  = el.dataset.year ?? "";
        const tags  = JSON.parse(el.dataset.tags  ?? "[]") as string[];
        const type  = el.dataset.type  ?? "";
        const dests = JSON.parse(el.dataset.destination ?? "[]") as string[];

        let visible = true;

        if (active.year.size        && !active.year.has(year))                   visible = false;
        if (visible && active.tag.size   && !tags.some(t  => active.tag.has(t))) visible = false;
        if (visible && active.type.size  && !active.type.has(type))              visible = false;
        if (visible && active.destination.size && !dests.some(d => active.destination.has(d))) visible = false;

        el.hidden = !visible;
      });

      // show/hide year groups + update counts
      yearGroups.forEach(group => {
        const groupArticles = group.querySelectorAll<HTMLElement>("article");
        const visibleItems  = [...groupArticles].filter(a => !a.hidden);

        group.hidden = visibleItems.length === 0;

        const countEl = group.querySelector("[data-count]");
        if (countEl) {
          countEl.textContent = `${visibleItems.length} ${visibleItems.length === 1 ? "post" : "posts"}`;
        }
      });

      // sync pill pressed state
      pills.forEach(pill => {
        const dim = pill.dataset.filterDim as Dim;
        const val = pill.dataset.filterVal ?? "";
        const pressed = active[dim]?.has(val) ?? false;
        pill.setAttribute("aria-pressed", String(pressed));
      });

      // show/hide clear button
      if (clear) clear.hidden = !hasActive;
    }

    // ── pill click → toggle Set → sync → apply ───────────────────────────

    pills.forEach(pill => {
      pill.addEventListener("click", () => {
        const dim = pill.dataset.filterDim as Dim;
        const val = pill.dataset.filterVal ?? "";
        if (!active[dim]) active[dim] = new Set();
        active[dim].has(val) ? active[dim].delete(val) : active[dim].add(val);
        syncUrl();
        applyFilters();
      });
    });

    // ── clear all ─────────────────────────────────────────────────────────

    clear?.addEventListener("click", () => {
      for (const dim of dims) active[dim].clear();
      syncUrl();
      applyFilters();
    });

    // ── initial apply (page load / back-forward with URL params) ─────────

    applyFilters();
  }

  initFilter();
  document.addEventListener("astro:after-swap", initFilter);
</script>