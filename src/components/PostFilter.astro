---
import { type TagInfo } from '@/utils/content.utils';
import SectionHeader from '@/components/SectionHeader.astro';

interface Props {
  tags?: TagInfo[];
  types?: string[];
  destinations?: string[];
  listId?: string; // optional if multiple lists
}

const { tags = [], types = [], destinations = [], listId = "post-feed" } = Astro.props;

// ── helpers ─────────────────────────────

const normalize = (v?: string | null) => v?.toLowerCase().trim();
const activeTag = normalize(Astro.url.searchParams.get("tag"));

// read multi-select params
const parse = (key: string) =>
  (Astro.url.searchParams.get(key) ?? "")
    .split(",")
    .map(normalize)
    .filter(Boolean);

const activeTags = parse("tag");
const activeTypes = parse("type");
const activeDest = parse("destination");

// toggle helper (add/remove)
const toggle = (arr: string[], val: string) =>
  arr.includes(val)
    ? arr.filter(v => v !== val)
    : [...arr, val];

// build URL
const hrefWith = (patch: Record<string, string[] | null>) => {
  const u = new URL(Astro.url.pathname, Astro.url);

  // copy existing
  Astro.url.searchParams.forEach((v, k) => u.searchParams.set(k, v));

  // apply patch
  Object.entries(patch).forEach(([k, arr]) => {
    if (!arr || arr.length === 0) u.searchParams.delete(k);
    else u.searchParams.set(k, arr.join(","));
  });

  return u.pathname + u.search;
};

const linkClass = (active: boolean) =>
  [
    "badge hover:text-content",
    active && "text-content badge"
  ].filter(Boolean).join(" ");
---
<section class="my-8 card-outline">
  <SectionHeader title='Filter posts' />
  
  <nav class="post-filter text-muted space-y-2">

    {/* TAGS */}
    {tags.length > 0 && (
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm font-bold text-muted">Tags:</span>
        
        <a data-filter-all href={hrefWith({ tag: null })} class="ml-4 badge ">All</a>
        <span class="opacity-40">·</span>

        {tags.map((t, i) => {
          const key = normalize(t.key);
          const active = activeTags.includes(key);

          return (
            <>
              <a
                data-filter-tag={t.key}
                href={activeTag === key ? Astro.url.pathname : `?tag=${t.key}`}
                class="badge"
              >
                #{t.label}
              </a>

              {i < tags.length - 1 && <span class="opacity-40">·</span>}
            </>
          );
        })}
      </div>
    )}

    {/* TYPE */}
    {types.length > 0 && (
      <div class="flex flex-wrap gap-x-2 gap-y-1">
        <span class="text-xs font-mono text-minimal">Type:</span>

        <a href={hrefWith({ type: null })} class={linkClass(activeTypes.length === 0)}>
          All
        </a>

        <span class="opacity-40">·</span>

        {types.map((t, i) => {
          const key = normalize(t);
          const active = activeTypes.includes(key);

          return (
            <>
              <a
                href={hrefWith({ type: toggle(activeTypes, key) })}
                class={linkClass(active)}
              >
                {active && <span class="mr-1">•</span>}
                {t}
              </a>

              {i < types.length - 1 && <span class="opacity-40">·</span>}
            </>
          );
        })}
      </div>
    )}

    {/* DESTINATION */}
    {destinations.length > 0 && (
      <div class="flex flex-wrap gap-x-2 gap-y-1">
        <span class="text-xs font-mono text-minimal">Destination:</span>

        <a
          href={hrefWith({ destination: null })}
          class={linkClass(activeDest.length === 0)}
        >
          All
        </a>

        <span class="opacity-40">·</span>

        {destinations.map((d, i) => {
          const key = normalize(d);
          const active = activeDest.includes(key);

          return (
            <>
              <a
                href={hrefWith({ destination: toggle(activeDest, key) })}
                class={linkClass(active)}
              >
                {active && <span class="mr-1">•</span>}
                {d}
              </a>

              {i < destinations.length - 1 && <span class="opacity-40">·</span>}
            </>
          );
        })}
      </div>
    )}

  </nav>
</section>

<script>
  const params = new URLSearchParams(window.location.search);

  const parse = (key) =>
    (params.get(key) || "")
      .toLowerCase()
      .split(",")
      .map(v => v.trim())
      .filter(Boolean);

  const active = {
    tags: parse("tag"),
    types: parse("type"),
    dests: parse("destination"),
  };

  const root = document.getElementById("post-feed") || document.querySelector(".post-feed");

  const items = root.querySelectorAll("article");

  items.forEach(el => {
    let visible = true;

    const tags = JSON.parse(el.dataset.tags || "[]");
    const type = (el.dataset.type || "").toLowerCase();
    const dests = JSON.parse(el.dataset.destination || "[]");

    // TAG (multi-select OR)
    if (active.tags.length && !active.tags.some(t => tags.includes(t))) {
      visible = false;
    }

    // TYPE
    if (visible && active.types.length && !active.types.includes(type)) {
      visible = false;
    }

    // DEST
    if (visible && active.dests.length && !active.dests.some(d => dests.includes(d))) {
      visible = false;
    }

    el.hidden = !visible;
  });

  // update grouped counts
  root.querySelectorAll("[data-year]").forEach(group => {
    const items = group.querySelectorAll("article");
    const visibleItems = [...items].filter(i => !i.hidden);

    group.hidden = visibleItems.length === 0;

    const countEl = group.querySelector("[data-count]");
    if (countEl) {
      countEl.textContent = `${visibleItems.length} ${
        visibleItems.length === 1 ? "post" : "posts"
      }`;
    }
  });

  // highlight active tags
  document.querySelectorAll("[data-filter-tag]").forEach(el => {
    const key = el.dataset.filterTag.toLowerCase();

    if (active.tags.includes(key)) {
      el.classList.add("text-content", "font-bold", "bg-elevated", "badge");
    }
  });

  // highlight "All"
  if (active.tags.length === 0) {
    document.querySelector("[data-filter-all]")?.classList.add(
      "text-content", "font-bold", "bg-elevated", "badge");
  }
</script>