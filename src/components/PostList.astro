---
/*
 * PostList — groups a flat post array by year and renders them.
 *
 * Accepts a flat array — grouping is handled internally.
 * Pages pass their already-fetched posts; no querying happens here.
 *
 * Used by: index.astro, posts/[...page].astro, tags/[tag].astro
*/
import { type AnyPost, getPostsGroupedByYear } from "@/utils/content.utils";
import SectionHeader from "./SectionHeader.astro";
import PostListItem from "./PostListItem.astro";

interface Props {
  publishedPosts: AnyPost[];
  sectionTitle?: string;
  sectionDesc?: string;
  showGrouped?: boolean;
  enableFilter?: boolean;
  listId?: string;
  variant?: string;
}

const { 
  publishedPosts,
  sectionTitle,
  sectionDesc,
  showGrouped = false,
  enableFilter = false,
  listId = "post-list",
  variant = "default",
} = Astro.props;

const groupedEntries = showGrouped
  ? getPostsGroupedByYear(publishedPosts)
  : [];
---

<section id={listId} class="post-list my-6 py-2">
  <SectionHeader title={sectionTitle} subheading={sectionDesc} />
  {showGrouped ? (
    groupedEntries.map(([year, posts]) => (
      <section class="mb-6 flex flex-col" data-year={enableFilter ? year : undefined}>

        <div class="flex items-center gap-3 mb-4">
          <h3 class="text-muted shrink-0">
            {year}
          </h3>

          <div class="flex-1 h-px bg-ui/50" />

          <span
            data-count
            class="text-sm text-muted whitespace-nowrap shrink-0 transition-opacity duration-150"
          >
            {posts.length} {posts.length === 1 ? 'post' : 'posts'}
          </span>
        </div>

        <div role="list">
          {posts.map((post) => (
            <PostListItem post={post} enableFilter={enableFilter} variant={variant} />
          ))}
        </div>

      </section>
    ))
  ) : (
    <div role="list">
      {publishedPosts.map((post) => (
        <PostListItem post={post} enableFilter={enableFilter} variant={variant} />
      ))}
    </div>
  )}
</section>