---
/**
 * BaseLayout — shared structural scaffold for all content pages.
 *
 * Slots:
 *   header     — page title, meta (PageHeader)
 *   content    — main content, wrapped in <article data-pagefind-body>
 *   navigation — contextual navigation (SeriesNav, prev/next, breadcrumbs)
 *   after      — supplementary content (related posts, comments)
 *
 * Used by BlogLayout and PageLayout.
 */
import Head from "@/components/Head.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---
<!DOCTYPE html>
<html>
  <Head>
    <slot name="seo" slot="seo" />
    <slot name="head" slot="head" />
  </Head>
  <body>
    <!-- Header -->
    <Header />
    
    <div class="wrap medium">
      <!-- Main content -->
      <main>
        {/* Page/Post Header Section */}
        <slot name="header" />

        {/* Page/Post Meta Section */}
        <slot name="meta" />

        {/* Page/Post Content */}
        <slot />

        {/* Post Navigation */}
        <slot name="navigation" />

        {/* Additional Content */}
        <slot name="after" />

      </main>
    </div>
    
    <!-- Footer -->
    <Footer />

    <!-- <ScrollToTop /> -->
    
    <!-- Additional page-specific scripts -->
    <slot name="scripts" />
  </body>
</html>