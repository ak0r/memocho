---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { type Post, getAllPosts, getRelatedPosts, getSeriesPosts, getPostSlug } from "@/utils/content.utils";
import { getGalleryImages, getCoverImage } from '@/utils/image.utils';
import { calculateReadingTime } from "@/utils/text.utils";
import { siteConfig } from "@/site.config";
import PageHeader from "@/components/PageHeader.astro";
import PostMeta from "@/components/PostMeta.astro";
import PostContext from "@/components/PostContext.astro";
import PostTaxonomy from "@/components/PostTaxonomy.astro";
import PostNavigation from "@/components/PostNavigation.astro";
import PostFeed from "@/components/PostFeed.astro";
import PostGallery from "@/components/PostGallery.astro";
import GalleryInit from '@/components/GalleryInit.astro';
import Breadcrumb from "@/components/Breadcrumb.astro"
import ImageWrapper from "@/components/ImageWrapper.astro";
import SEO from "@/components/SEO.astro";
import SchemaOrg from "@/components/SchemaOrg.astro";

interface Props {
  entry: Post;
}

const { entry } = Astro.props;
const isTravel = entry.collection === 'posts';

const {
  title,
  description,
  published,
  updated,
  tags,
  cover,
  series,
  type = ''
} = entry.data;

// Travel-only fields
const countries = isTravel ? (entry as CollectionEntry<'posts'>).data.countries : undefined;
const region    = isTravel ? (entry as CollectionEntry<'posts'>).data.region    : undefined;
const places    = isTravel ? (entry as CollectionEntry<'posts'>).data.places    : undefined;

const placesLabel = places?.join(', ') ?? '';
const allPosts      = await getAllPosts();
const related       = getRelatedPosts(entry, allPosts, siteConfig.relatedPosts);
const seriesPosts   = series ? await getSeriesPosts(series) : [];
const readTime      = calculateReadingTime(entry.body ?? "").text;
const coverImage    = getCoverImage(cover);
const galleryImages = getGalleryImages(entry.filePath ?? '');
const ogImage       = `/og/${entry.collection}/${getPostSlug(entry)}.png`;

const currentIndex = allPosts.findIndex(
  (p) => p.id === entry.id && p.collection === entry.collection
);

const prev = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const next = currentIndex > 0                   ? allPosts[currentIndex - 1] : null;

---
<BaseLayout>
  <SEO
    slot="seo"
    {title}
    description={description ?? ""}
    type="article"
    publishedTime={published}
    {tags}
    {ogImage}
  />

  <SchemaOrg
    type="article"
    entry={entry}
    slot="seo"
  />
  
  <Fragment slot="header">
    <div class="flex flex-col gap-8">

      <div class="flex flex-col gap-4">
        <Breadcrumb label={title} />
        <PageHeader {title}>
          <PostMeta
            slot="meta"
            {published}
            {updated}
            {readTime}
          />
        </PageHeader>
      </div>
      
      {coverImage && (
        <section class="rounded-lg ring ring-border shadow-sm breakout">
        <ImageWrapper 
          src={coverImage} 
          alt={title}
        />
      </section>
      )}

      {isTravel && (
        <PostContext type={type} location={placesLabel} />
      )}
      <div class="divider"></div>
    </div>
  </Fragment>
  
  <aside data-pagefind-body>

    <!-- Pagefind Meta entries -->
    <meta data-pagefind-meta="title[content]" content={title} />
    <meta data-pagefind-sort="date[content]" content={published.toISOString()} />
    <meta data-pagefind-filter="collection[content]" content={entry.collection} />
    {
      tags?.map((tag) => (
        <meta data-pagefind-filter="tag[content]" content={tag} />
      ))
    }

    <section class="post-content border-border" role="article">
      <slot />
    </section>

    {galleryImages.length > 0 && (
      <PostGallery images={galleryImages} galleryId={entry.id} />
    )}

    <PostTaxonomy {tags} />
  </aside>
  
  {/* NAVIGATION SLOT */}
  <Fragment slot="navigation">
    <PostNavigation
      current={entry} 
      seriesPosts={seriesPosts}
      prev={prev} 
      next={next}
    />
  </Fragment>

  {/* AFTER SLOT */}
  <Fragment slot="after">
    {related.length > 0 && (
      <PostFeed
        posts={related}
        variant="compact"
        sectionTitle="Related"
      />
    )}
  </Fragment>

  <GalleryInit slot="scripts" />
</BaseLayout>