---
import SEO from "@/components/SEO.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

interface Props {
  title: string;
  description?: string;
  updated?: Date;
  showBreadcrumb?: boolean;
}

const { title, description, updated, showBreadcrumb = true } = Astro.props;

const formattedDate = updated?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});
---

<BaseLayout>
  <SEO slot="seo" {title} description={description ?? ""} />

  <Fragment slot="header">
    {showBreadcrumb && <Breadcrumb label={title} />}

    <PageHeader {title} subheading={description} >
      {updated && (
        <div slot="meta">
          <span class="text-minimal text-sm">Updated {formattedDate}</span>
        </div>
      )}
    </PageHeader>
  </Fragment>
  <section data-pagefind-body class="page-content my-8">
    <meta data-pagefind-filter="collection[content]" content="page" />
    <meta data-pagefind-sort="date[content]" content={formattedDate} />
    <slot />
  </section>
</BaseLayout>