---
import type { CollectionEntry } from "astro:content";
// import SEO from "@/components/SEO.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const { title, description, updated } = entry.data;

const formattedDate = updated?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});
---

<BaseLayout>
  <!-- <SEO slot="seo" {title} description={description ?? ""} /> -->
  <Fragment slot="header">
    <Breadcrumb label={title} />
    <PageHeader {title}>
      {updated && (
        <span slot="meta">Updated {formattedDate}</span>
      )}
    </PageHeader>
  </Fragment>
  <Fragment>
    <slot />
  </Fragment>
  <!-- navigation and after slots unused for static pages -->
</BaseLayout>