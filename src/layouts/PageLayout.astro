---
import SEO from "@/components/SEO.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { type AnyPost } from "@/utils/content.utils";

interface Props {
  entry?: AnyPost;
  title?: string;
  description?: string;
  showBreadcrumb?: boolean;
}

const {
  entry,
  title: propTitle,
  description: propDescription,
  showBreadcrumb = true,
} = Astro.props;

const {
  title: entryTitle,
  description: entryDescription,
  published,
  updated,
} = entry?.data ?? {};

const title =
  propTitle ??
  entryTitle;

const description =
  propDescription ??
  entryDescription;

const last = updated ? updated : published;

const formattedDate = last?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});

const ogImage = entry
  ? `/og/${entry.id}.png`
  : undefined;
---

<BaseLayout>
  <SEO slot="seo" title={title} description={description ?? ""} ogImage={ogImage} />

  <Fragment slot="header">
    {showBreadcrumb && <Breadcrumb label={title} />}

    <PageHeader {title} subheading={description} >
      {formattedDate && (
        <div slot="meta">
          <span class="text-minimal text-sm">Updated {formattedDate}</span>
        </div>
      )}
    </PageHeader>
  </Fragment>
  <section data-pagefind-body class="page-content my-8">
    <meta data-pagefind-filter="collection[content]" content="page" />
    <meta data-pagefind-sort="date[content]" content={formattedDate} />
    <slot />
  </section>
</BaseLayout>