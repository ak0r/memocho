---
import { getEntry, render } from "astro:content";
import { siteConfig } from "@/site.config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SEO from "@/components/SEO.astro";
import SchemaOrg from "@/components/SchemaOrg.astro";
import { getAllPosts } from "@/utils/content.utils";
import PostFeed from "@/components/PostFeed.astro";
import HomeIntro from "@/components/HomeIntro.astro";

const allPosts = await getAllPosts();
---
<BaseLayout>
	<SEO slot="seo" title="Home" description={siteConfig.description} ogImage="/og/default.png" />
	<SchemaOrg slot="seo" type="website" />
	<h1 class="sr-only">{siteConfig.title}</h1>
	
	<HomeIntro />
	
	<PostFeed
		posts={allPosts.slice(0, siteConfig.recentPosts)}
		variant="card"
		sectionTitle="Recent"
	/>
<!-- 
	<PostFeed
		posts={allPosts.slice(0, siteConfig.recentPosts)}
		variant="compact"
		sectionTitle="Recent Tech"
	/> -->
</BaseLayout>
