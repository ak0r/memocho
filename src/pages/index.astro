---
import { getEntry, render } from "astro:content";
import { siteConfig } from "@/site.config";
import BaseLayout from "@/layouts/BaseLayout.astro";
// import SEO from "@/components/SEO.astro";
// import SchemaOrg from "@/components/SchemaOrg.astro";
import { getTravelPosts, getTechPosts } from "@/utils/content.utils";
import PostFeed from "@/components/PostFeed.astro";
import HomeIntro from "@/components/HomeIntro.astro";

const travelPosts = await getTravelPosts();
const techPosts = await getTechPosts();
---
<BaseLayout>
	<h1 class="sr-only">{siteConfig.title}</h1>
	
	<HomeIntro />
	
	<PostFeed
		posts={travelPosts.slice(0, siteConfig.recentPosts)}
		variant="card"
		sectionTitle="Recent Travels"
	/>

	<PostFeed
		posts={techPosts.slice(0, siteConfig.recentPosts)}
		variant="compact"
		sectionTitle="Recent Tech"
	/>
</BaseLayout>
