---
/**
 * /tech
 *
 * All tech posts with client-side filtering.
 * Filter dimensions: tag
 * URL state: /tech/?tag=homelab
 *
 * Year groupings are rendered at build time.
 * The filter script hides individual items but also hides year headings
 * when all posts in that year are filtered out.
 */

import { getTechPosts, getTechTags } from "@/utils/content.utils";
import PageLayout from "@/layouts/PageLayout.astro";
import PostFeed from "@/components/PostFeed.astro";
import PostFilter from "@/components/PostFilter.astro";

const allPosts = await getTechPosts();
const allTags = await getTechTags();
---
<PageLayout 
	title="Tech Notes" 
	description="Notes on building things — self-hosted infrastructure, developer tooling, and systems that stay out of the way."
>
	
	{allPosts.length > 0 ? (
		<>
			<PostFilter 
				listId="tech-list"
				tags={allTags}
			/>

			<PostFeed
				posts={allPosts}
				variant="archive"
				enableFilter
			/>
		</>
	) : (
		<p class="my-8 text-base text-fig font-mono">
			No published posts
		</p>
	)}
	
</PageLayout>
