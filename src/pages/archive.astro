---
/**
 * /archive/
 *
 * All posts with client-side filtering.
 * Year groupings rendered at build time.
 * Filter script hides items and year headings when all posts in a year are filtered out.
 */

import PageLayout from "@/layouts/PageLayout.astro";
import {
  getAllPosts,
  getAllTags,
  getDistinctYears,
  getDistinctThemes,
getDistinctCategories,
} from "@/utils/content.utils";
import PostFeed from "@/components/PostFeed.astro";
import PostFilter from "@/components/PostFilter.astro";

const allPosts   = await getAllPosts();
const allTags    = await getAllTags();
const allYears   = getDistinctYears(allPosts);
const allThemes  = getDistinctThemes(allPosts);
const allCategories = getDistinctCategories(allPosts);
---

<PageLayout
  title="Archive"
  description="Archive of stories related to Systems and Streets"
>
  {allPosts.length > 0 ? (
    <>
      <PostFilter
        tags={allTags}
        years={allYears}
        themes={allThemes}
				categories={allCategories}
      />
      <PostFeed
        posts={allPosts}
        variant="archive"
        enableFilter
      />
    </>
  ) : (
    <p class="my-8 text-base text-fig font-mono">
      No published posts
    </p>
  )}
</PageLayout>