---
/**
 * /travels/
 *
 * All travel posts with client-side filtering.
 * Filter dimensions: type, tag, destination
 * URL state: /travel/?type=story&tag=hiking&destination=india
 *
 * Year groupings are rendered at build time.
 * The filter script hides individual items but also hides year headings
 * when all posts in that year are filtered out.
 */

import PageLayout from "@/layouts/PageLayout.astro";
import { getAllPosts, getAllTags, getDistinctYears, getDistinctCountries, getDistinctThemes  } from "@/utils/content.utils";
import PostFeed from "@/components/PostFeed.astro";
import PostFilter from "@/components/PostFilter.astro";

const allPosts = await getAllPosts();
const allTags = await getAllTags();
const allYears = getDistinctYears(allPosts);
const allCountries = getDistinctCountries(allPosts);
const allThemes = getDistinctThemes(allPosts);
---
<PageLayout 
	title="Archive" 
	description="Archive of stories related Systems and Streets"
>

	{allPosts.length > 0 ? (
		<>
			<PostFilter
				tags={allTags}
				years={allYears}
				// countries={allCountries}
				themes={allThemes}
			/>
			<PostFeed
				posts={allPosts}
				variant="archive"
				enableFilter
			/>
		</>
	) : (
		<p class="my-8 text-base text-fig font-mono">
			No published posts
		</p>
	)}
	
</PageLayout>